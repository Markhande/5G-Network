<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="20dp"
    android:background="#F5F7FA">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="24dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network Status"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:letterSpacing="0.05"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detecting..."
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:letterSpacing="-0.02"/>

            <View
                android:layout_width="60dp"
                android:layout_height="4dp"
                android:background="#3B82F6"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Quick Actions Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:letterSpacing="0.05"
            android:textAllCaps="true"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Network Settings"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_primary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <Button
                android:id="@+id/btnTesting"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Testing Menu"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_secondary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_testing"
                android:drawablePadding="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

        </LinearLayout>

        <!-- Network Mode Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Network Mode"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:letterSpacing="0.05"
            android:textAllCaps="true"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="2dp">

            <Button
                android:id="@+id/btnLteOnly"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="LTE Only"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_secondary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_lte"
                android:drawablePadding="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <Button
                android:id="@+id/btnNrOnly"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="5G NR Only"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_secondary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_5g"
                android:drawablePadding="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>