<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#10B981"
                android:endColor="#059669"
                android:type="linear"/>
            <corners android:radius="10dp"/>
            <stroke android:width="2dp" android:color="#34D399"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#34D399"
                android:endColor="#10B981"
                android:type="linear"/>
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="#6EE7B7"/>
        </shape>
    </item>
</selector>